---
const { title, description } = Astro.props;
const base = Astro.site ?? Astro.url;
const image = new URL('/social-share.png', base).href;
---
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Triangle 13 Black" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={new URL(Astro.url.pathname, base).href} />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1730" />
<meta property="og:image:height" content="909" />
<meta property="og:image:alt" content="Big dreams. One team. Triangle 13 Black National, Raleigh, NC, 2027 season. Blue and white volleyball with a call to back their next big step." />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content="Big dreams. One team. Back Triangle 13 Black National's 2027 season." />
