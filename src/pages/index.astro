---
import { events, guide, levels } from '../data/season';
import '../styles/global.css';
import SocialMeta from '../components/SocialMeta.astro';
import SeasonBudget from '../components/SeasonBudget.astro';
import { budget, money } from '../data/season';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Big dreams. One team. | Triangle 13 Black</title>
  <meta name="description" content="Help Triangle 13 Black National take on the 2027 volleyball season. Explore the tournament calendar, transparent costs, and proposed sponsorship opportunities." />
  <meta name="theme-color" content="#101214" /><meta name="robots" content="noindex, nofollow" />
  <SocialMeta title="Big dreams. One team. | Triangle 13 Black" description="A hometown behind every away game. Support the 2027 season." />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
<a href="#main" class="skip">Skip to content</a>
<div class="preview-bar">2027 SPONSORSHIP PREVIEW <span>Parent-led proposal · packages subject to team approval</span></div>
<header class="header wrap">
  <a href="#" class="brand" aria-label="Triangle 13 Black home"><span class="brand-symbol">13</span><span>TRIANGLE <b>13 BLACK / NATIONAL</b></span></a>
  <nav aria-label="Main navigation"><a href="#story">Our team</a><a href="#season">The season</a><a href="#impact">Your impact</a></nav>
  <a href="#sponsor" class="button small">Back the team <span aria-hidden="true">↗</span></a>
</header>
<main id="main">
<section class="hero wrap">
  <div class="hero-copy"><p class="eyebrow"><span class="dot"></span> TRIANGLE VOLLEYBALL · 2026–27</p><h1>BIG DREAMS.<br />ONE <span>TEAM.</span></h1><p class="hero-description">The work starts here. The journey goes everywhere.<br class="desktop" /> Help 13 Black take their next big step.</p><div class="actions"><a href="#sponsor" class="button">Become a sponsor <span aria-hidden="true">↗</span></a><a href="#season" class="text-link">Explore the season <span aria-hidden="true">↓</span></a></div><div class="hero-foot"><span>RALEIGH, NORTH CAROLINA</span><span>13U GIRLS · NATIONAL</span></div></div>
  <div class="hero-art" role="img" aria-label="Graphic of a volleyball over a blue court with the number 13"><div class="court-grid"></div><span class="art-top">BUILT HERE. <b>BOUND FOR MORE.</b></span><span class="giant-number">13</span><svg class="ball" viewBox="0 0 320 320" aria-hidden="true"><defs><radialGradient id="shade" cx="32%" cy="26%" r="75%"><stop offset="0" stop-color="#fff"/><stop offset=".6" stop-color="#edeae3"/><stop offset="1" stop-color="#a9a9a0"/></radialGradient><clipPath id="circle"><circle cx="160" cy="160" r="145"/></clipPath></defs><circle cx="164" cy="172" r="144" fill="#082849" opacity=".3"/><circle cx="160" cy="160" r="145" fill="url(#shade)"/><g clip-path="url(#circle)" fill="none" stroke="#162331" stroke-width="2.5"><path d="M160 160Q140 70 58 37M160 160Q224 103 296 113M160 160Q174 252 95 298"/><path d="M77 23Q184 63 195 139M106 14Q219 60 226 123M298 139Q215 151 188 269M306 175Q232 183 218 295M68 280Q127 208 103 95M37 249Q87 168 66 68"/></g><path d="M77 23Q184 63 195 139L226 123Q219 60 106 14Z" fill="#288cd7" clip-path="url(#circle)"/><path d="M298 139Q215 151 188 269L218 295Q232 183 306 175Z" fill="#288cd7" clip-path="url(#circle)"/><path d="M68 280Q127 208 103 95L66 68Q87 168 37 249Z" fill="#288cd7" clip-path="url(#circle)"/></svg><span class="art-bottom">EVERY REP. EVERY RALLY. <b>TOGETHER.</b></span><div class="season-stamp">THE<br /><strong>2027</strong><br />SEASON</div></div>
</section>
<div class="ticker" aria-label="Team values"><div>LOCAL ROOTS <span>✳</span> NATIONAL AMBITION <span>✳</span> ONE TEAM <span>✳</span> A COMMUNITY BEHIND US <span>✳</span></div></div>
<section class="section wrap story" id="story"><div><p class="eyebrow">01 / MORE THAN A GAME</p><h2>A hometown behind<br />every away game.</h2></div><div><p class="lead">At 13, the biggest thing you can build isn’t a trophy collection. It’s belief.</p><p>Triangle 13 Black is a girls’ national volleyball team based in Raleigh, North Carolina. This season means learning to compete, showing up for teammates, and taking on challenges far from home.</p><p>Your support helps ease the costs that come with that opportunity—so families can focus more on the experience and athletes can focus on the next ball.</p><div class="coaches"><span>2027 COACHING TEAM</span><strong>Richard Tharrington <small>Head coach</small></strong><strong>Maggie Ruhl <small>Assistant coach</small></strong></div></div></section>
<section class="legacy"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">A PROGRAM WITH A PURPOSE</p><h2>Small beginnings.<br />A proven foundation.</h2></div><a href={guide} target="_blank" rel="noreferrer" class="text-link">Meet Triangle Volleyball ↗</a></div><div class="stat-grid"><div><strong>25<span>th</span></strong><h3>Season of development</h3><p>Triangle enters its 25th season in 2026–27.</p></div><div><strong>#38</strong><h3>National club ranking</h3><p>Triangle reports a No. 38 US Club Ranking for 2026.</p></div><div><strong>~90</strong><h3>Coaches across the club</h3><p>A program drawing on high school, club, and college experience.</p></div></div><div class="alumni"><span>THE NEXT CHAPTER CAN GO A LONG WAY</span><p>Triangle’s alumni directory lists college commitments including <b>Penn State, Nebraska, UNC, and UCLA.</b> Every journey starts with a place to grow.</p><a href="https://trianglevolleyball.org/club-program/alumni/" target="_blank" rel="noreferrer">Explore the alumni directory ↗</a></div><p class="fine">Club-wide history and alumni commitments, not outcomes or endorsements promised for this team. <a href={guide}>2027 program guide</a> · <a href="https://trianglevolleyball.org/club-program/alumni/">Alumni source</a></p></div></section>
<section class="section wrap" id="season"><div class="section-heading"><div><p class="eyebrow">02 / THE ROAD AHEAD</p><h2>One season.<br />So much possibility.</h2></div><div class="section-aside"><p>From home courts to national qualifiers.<br />Follow the published 2027 tournament plan.</p><a class="text-link" href="/season.ics" download>Add the season to your calendar ↓</a></div></div><div class="filters" role="group" aria-label="Filter tournaments"><button class="active" data-filter="All" aria-pressed="true">All events</button><button data-filter="Home" aria-pressed="false">Close to home</button><button data-filter="Qualifier" aria-pressed="false">Qualifiers</button><button data-filter="Travel" aria-pressed="false">Travel</button></div><p class="sr-only" id="filter-status" aria-live="polite"></p><div class="schedule">{events.map((event, i) => <article class="event" data-type={event.type}><div class="event-date"><span>{event.month}</span><strong>{event.days}</strong></div><div class="event-info"><h3>{event.name}</h3><p>{event.city}</p><p class="trip-cost">{event.type === 'Home' ? 'Local event · no travel allowance' : `${money(budget.travelPerTrip)} / athlete · estimated food & travel${event.type === 'Backup' ? ' · excluded from total' : ''}`}</p></div><span class:list={['tag', { blue: event.type === 'Home', muted: event.type === 'Backup' }]}>{event.type === 'Backup' ? 'Backup only' : event.type}</span><span class="event-index" aria-hidden="true">{String(i+1).padStart(2,'0')}</span></article>)}</div><div class="nationals"><span class="eyebrow">THE SEASON FINALE</span><h3>One national championship. Two possible paths.</h3><div><p><b>AAU Junior Nationals · Orlando</b><br />Four competition days within June 13–28; exact dates TBD.</p><span class="or">OR</span><p><b>USAV Junior Nationals · Chicago</b><br />June 18–21, if the team qualifies.</p></div><p class="trip-cost">Budgeted once: {money(budget.travelPerTrip)} per athlete in estimated food & travel, whichever championship the team attends.</p></div><p class="fine">Source: <a href={guide}>Triangle’s 13s program guide, revised September 9, 2026</a>. Schedule may change. Dates are competition days; travel typically begins the day before. Calendar download includes eight planned tournaments, excluding the backup qualifier and undecided national championship.</p><details><summary>Practice and preseason calendar <span>+</span></summary><p>Athlete onboarding: September 30, 2026, 2:30–6 p.m. OR October 12, noon–5 p.m. Preseason practice: October 25, 4:30–6:45 p.m. Signing celebration: November 4, 7 p.m., Raleigh Convention Center.</p><p>The event table lists November 8 as 13 Black’s first official practice. Regular weekday sessions are Monday/Wednesday, 7:15–9:30 p.m.; Sunday sessions are 3:15–5:15 p.m. or 5:30–7:30 p.m., generally November–January. Exact dates and exceptions belong on the team’s official calendar.</p></details></section>
<section class="impact" id="impact"><div class="wrap section"><div><p class="eyebrow">03 / WHAT YOUR SUPPORT MAKES POSSIBLE</p><h2>Big commitment.<br /><span>Real-world costs.</span></h2><p class="lead">Talent and effort get them on the court.<br />Community helps them go further.</p><p>Coaching, court time, competition, and travel all add up. Sponsorship can help reduce the financial load of a national season.</p><p class="budget-assumption">Budget based on <strong>10 players</strong> and <strong>7 travel trips</strong>.</p><p class="fine">Travel allowance is a parent planning estimate, separate from the club’s published fees.</p></div><SeasonBudget /></div></section>
<section class="section wrap" id="sponsor"><div class="section-heading"><div><p class="eyebrow">04 / BE PART OF THEIR SEASON</p><h2>Good businesses.<br />Great teammates.</h2></div><div class="section-aside"><p>Choose a starting point. Build a connection.<br />Help a local team take on what’s next.</p><span class="proposal-label">Proposed sponsorship packages</span></div></div><div class="sponsor-grid">{levels.map((level, i) => <article class:list={['sponsor-card',{featured:i===1}]}><span class="eyebrow">0{i+1} / {level.name}</span><h3>${level.amount.toLocaleString()}<small> / season</small></h3><p>{level.description}</p><ul>{level.benefits.map(benefit=><li>{benefit}</li>)}</ul><button class:list={['button',{light:i!==1}]} data-tier={level.name} data-amount={level.amount}>Let’s team up <span aria-hidden="true">↗</span></button></article>)}</div><article class="corporate"><div><p class="eyebrow">FOR COMPANIES READY TO MAKE A BIGGER PLAY</p><h3>Back a whole season.<br />Build a shared story.</h3><p>A $2,500–$5,000+ partnership can make a meaningful contribution across the team. Co-create a plan for travel support, season expenses, or a shared live-sports experience.</p><div class="corporate-links"><button class="button" data-tier="Company partnership" data-amount="5000">Explore a team partnership ↗</button><a href="/pitch/gametime" class="text-link">See the Gametime proposal ↗</a></div></div><div><span class="eyebrow">PROPOSED PARTNER EXPERIENCE</span><ul><li>Featured recognition on this parent-led team page</li><li>Midseason update and season-end impact recap</li><li>Agreed use of funds and aggregate expense reporting</li><li>Optional employee connection or team experience</li></ul><p class="fine">All deliverables subject to team and club agreement. Photos and athlete stories require family consent. Audience reach and commercial returns are not guaranteed.</p></div></article><div class="custom"><div><h3>There’s more than one way to show up.</h3><p>Have another amount in mind? Meals, travel support, or an in-kind partnership could make a difference, too.</p></div><button class="text-link" data-tier="Custom / in-kind partnership" data-amount="">Start a conversation ↗</button></div><p class="fine">Parent-led proposal. Recognition, allocation of funds, and any use of club branding must be agreed with the team and club before accepting support. No jersey placement, official club endorsement, or tax deductibility is promised.</p></section>
<section class="closing wrap"><span class="eyebrow">THE NEXT CHAPTER STARTS WITH US.</span><h2>BE THE REASON<br />THEY GO <span>FURTHER.</span></h2><a class="button" href="#sponsor">Find your place on the team ↗</a><button class="text-link" id="print">Print the sponsor brief ↓</button></section>
<section class="wrap faq"><h2>A few good questions.</h2><details><summary>Where would sponsorship funds go?<span>+</span></summary><p>The proposal is to help with team families’ season costs, such as dues, uniforms, or travel. The parent coordinator and team will confirm how funds are collected, allocated, and reported before accepting any money.</p></details><details><summary>Can my business receive recognition?<span>+</span></summary><p>The proposed packages include recognition on this parent-organized page and team updates. Specific deliverables require team approval. Club social media, jerseys, and facility signage are not included.</p></details><details><summary>Is this an official Triangle fundraising page?<span>+</span></summary><p>No. This is a parent-led sponsorship proposal for 13 Black National. The published club guide supplies season facts; the proposed sponsor packages are separate and await coordination with the team and club.</p></details><details><summary>Can I make a payment here?<span>+</span></summary><p>Not yet. This page starts a sponsorship conversation. Payment instructions and the recipient will be confirmed by the coordinator after the team agrees on the fundraising plan.</p></details></section>
</main>
<footer class="wrap"><a href="#" class="brand"><span class="brand-symbol">13</span><span>TRIANGLE <b>13 BLACK / NATIONAL</b></span></a><p>A parent-led effort. A community-sized difference.<br />2026–27 season · Raleigh, North Carolina</p><a href={guide} target="_blank" rel="noreferrer">Official program guide ↗</a></footer>
<dialog id="inquiry" aria-labelledby="inquiry-title"><button class="close" aria-label="Close sponsorship inquiry">×</button><p class="eyebrow">LET’S TEAM UP</p><h2 id="inquiry-title">Start a sponsorship conversation.</h2><p id="selected-tier"></p><form id="inquiry-form" name="sponsorship" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field"><input type="hidden" name="form-name" value="sponsorship" /><input type="hidden" name="sponsorship-level" id="sponsorship-level" value="General inquiry" /><p hidden><label>Leave this empty<input name="bot-field" tabindex="-1" autocomplete="off" /></label></p><label>Your name<input name="name" autocomplete="name" required maxlength="100" /></label><label>Business or organization<input name="business" autocomplete="organization" maxlength="150" /></label><label>Email<input type="email" name="email" autocomplete="email" required maxlength="200" /></label><label>What do you have in mind?<textarea name="message" rows="3" maxlength="2000"></textarea></label><button class="button" type="submit">Send sponsorship inquiry ↗</button><p class="fine">Your details will be shared with the parent sponsorship coordinator through Netlify Forms to respond to your inquiry. No payment is collected.</p></form></dialog>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  buttons.forEach(button => button.addEventListener('click', () => {
    let count = 0;
    document.querySelectorAll<HTMLElement>('.event').forEach(event => { const show = button.dataset.filter === 'All' || event.dataset.type === button.dataset.filter; event.hidden = !show; if(show) count++; });
    buttons.forEach(b => {b.classList.toggle('active', b === button); b.setAttribute('aria-pressed', String(b === button));});
    document.querySelector('#filter-status')!.textContent = `${count} events shown`;
  }));
  const dialog = document.querySelector<HTMLDialogElement>('#inquiry')!;
  let tier = '';
  document.querySelectorAll<HTMLButtonElement>('[data-tier]').forEach(button => button.addEventListener('click', () => {tier = button.dataset.tier! + (button.dataset.amount ? ` — $${Number(button.dataset.amount).toLocaleString('en-US')}` : ''); document.querySelector('#selected-tier')!.textContent = tier; document.querySelector<HTMLInputElement>('#sponsorship-level')!.value = tier; dialog.showModal();}));
  dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', event => {if(event.target === dialog) {const rect=dialog.getBoundingClientRect(); if(event.clientX<rect.left || event.clientX>rect.right || event.clientY<rect.top || event.clientY>rect.bottom) dialog.close();}});
  document.querySelector('#print')!.addEventListener('click', () => window.print());
</script>
</body></html>
